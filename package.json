{
  "name": "weather-remotion-reels",
  "version": "1.0.0",
  "private": true,
  "description": "60-second Persian meteorology explainer, rendered with Remotion for Instagram Reels (1080x1920).",
  "license": "MIT",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "render": "remotion render src/index.ts WeatherReels out/weather.mp4 --codec=h264 --audio-codec=aac --jpeg-quality=92 --concurrency=4 --overwrite",
    "still": "remotion still src/index.ts WeatherReels out/frame.png --frame=300",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.539",
    "@remotion/fonts": "4.0.539",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.539"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "typescript": "5.9.2"
  }
}
